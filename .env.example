# ==============================================================================
# HINGLISH AI SALES CALLING AGENT - ENVIRONMENT CONFIGURATION
# Every setting and its default lives in config/settings.py
# ==============================================================================
ENVIRONMENT=development          # production refuses sandbox payments/messages and requires API_KEYS
API_KEYS=                        # comma-separated keys for the X-API-Key header (open in development if empty)
AUTH_SECRET=                     # signs portal logins; required in production (long random string)
COMPANY_NAME=NavyaNexus
AGENT_PERSONA_NAME=Priya

# --- Providers (the default build needs only OpenAI) ---------------------------
STT_PROVIDER=indicconformer      # indicconformer | whisper_hinglish | sarvam
LLM_PROVIDER=openai              # openai | selfhosted | sarvam
LLM_FALLBACK_PROVIDER=           # empty keeps using REALTIME_LLM_FALLBACK_*
LLM_REASONING_EFFORT=            # reasoning models only; empty picks the lowest the model supports
TTS_PROVIDER=piper               # piper (local) | server (TTS service) | openai | sarvam
PIPER_VOICE=hi_IN-priyamvada-medium   # non-commercial training data: for demos only
PIPER_LENGTH_SCALE=0.85          # speech pace; below 1.0 is faster

# --- OpenAI and self-hosted LLM ---------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TTS_SPEED=1.2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
SELFHOSTED_LLM_BASE_URL=         # e.g. http://gpu-box:8000/v1 for Sarvam-30B on vLLM
SELFHOSTED_LLM_API_KEY=
SELFHOSTED_LLM_MODEL=

# --- Speech services (STT and TTS run as their own services) -------------------
# The same SPEECH_SERVER_TOKEN goes in the pipeline's .env and on each service. Empty = no check (local only).
SPEECH_SERVER_TOKEN=
STT_SERVER_URL=ws://127.0.0.1:8765/v1/stt    # remote: wss://<host>/v1/stt
STT_SERVER_STREAMING=true        # one connection per call, audio sent as it arrives
STT_FALLBACK_TO_SARVAM=false
STT_PARTIALS_ENABLED=false       # expensive on CPU
STT_INDICCONFORMER_DEVICE=cpu    # cuda on a GPU box (needs onnxruntime-gpu)
HF_TOKEN=                        # gated models; accept their terms on Hugging Face first
TTS_SERVER_URL=ws://127.0.0.1:8766/v1/tts    # used when TTS_PROVIDER=server; remote: wss://<host>/v1/tts
TTS_SERVER_VOICE=maya-ahana      # name cached audio is filed under; change it when the service's voice changes
TTS_FALLBACK_TO_SARVAM=false     # speak through Bulbul when the TTS service fails (needs SARVAM_API_KEY)

# --- TTS service side (read by python -m speech.tts_server) ---------------------
TTS_ENGINE=maya                  # maya | svara | piper
TTS_FALLBACK_ENGINE=svara        # used when the main voice fails; empty for none
TTS_MAYA_VOICE=Ahana
TTS_MAYA_SEATS=1                 # sentences at once; more seats use more GPU memory
TTS_SVARA_GGUF=models/svara/svara-tts-v1-Q3_K_M.gguf
TTS_SVARA_GPU_LAYERS=-1          # 0 runs Svara on the CPU
TTS_SVARA_SPEED=1.1

# --- Real-time LLM (OpenAI-compatible; choose by benchmark) -------------------
REALTIME_LLM_API_KEY=your_sarvam_api_key_here
REALTIME_LLM_BASE_URL=https://api.sarvam.ai/v1
REALTIME_LLM_MODEL=sarvam-105b-conversations
REALTIME_LLM_EXTRA_BODY={"reasoning_effort": null}
REALTIME_LLM_TEMPERATURE=0.3
REALTIME_LLM_TIMEOUT_SECONDS=1.5
# Optional second vendor for failover
REALTIME_LLM_FALLBACK_BASE_URL=
REALTIME_LLM_FALLBACK_API_KEY=
REALTIME_LLM_FALLBACK_MODEL=

# --- Offline LLM (summaries, QA) ----------------------------------------------
OFFLINE_LLM_API_KEY=your_sarvam_api_key_here
OFFLINE_LLM_MODEL=sarvam-105b

# --- Sarvam speech -------------------------------------------------------------
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=translit         # Roman-script Hinglish transcripts
SARVAM_STT_SAMPLE_RATE=8000
BULBUL_TTS_MODEL=bulbul:v4-flash
BULBUL_TTS_VOICE_ID=simran_enhi_customer   # try ritu_hi_sales, simran_hi_sales, ishita_enhi_customer
BULBUL_TTS_SAMPLE_RATE=8000
BULBUL_TTS_PACE=1.0

# --- LiveKit (self-hosted, Mumbai) ---------------------------------------------
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=   # needed only for real phone calls
LIVEKIT_PUBLIC_URL=              # URL browsers use for test calls (defaults to LIVEKIT_URL)

# --- Telephony (Plivo) ---------------------------------------------------------
PLIVO_AUTH_ID=your_plivo_auth_id_here
PLIVO_AUTH_TOKEN=your_plivo_auth_token_here
PLIVO_CALLER_ID_PROMOTIONAL=+911401234567
PLIVO_CALLER_ID_TRANSACTIONAL=
PLIVO_BILLING_PULSE_SECONDS=60
PLIVO_RATE_PER_MINUTE_INR=0.45
PLIVO_MAX_CALLS_PER_SECOND=2
PLIVO_ZENTRUNK_TERMINATION_URI=
PLIVO_ZENTRUNK_USERNAME=
PLIVO_ZENTRUNK_PASSWORD=
PLIVO_WHATSAPP_SENDER=
PLIVO_SMS_SENDER_ID=

# --- Payments & human transfer ---------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
HUMAN_TRANSFER_NUMBERS=          # e.g. +919800000001,+919800000002

# --- Data -----------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/voiceagent
REDIS_URL=redis://localhost:6379/0

# --- Dialer and portal limits -----------------------------------------------------
DIALER_MAX_CONCURRENT_CALLS=100
DEFAULT_CLIENT_MAX_CONCURRENT_CALLS=5
TEST_CALL_MONTHLY_MINUTES=30
# Landing page "Talk to Priya" demo (no login; uses the real worker, LLM and TTS)
DEMO_CALL_ENABLED=true
DEMO_CAMPAIGN_ID=CAMP-REENGAGE-Q4   # whose script the demo agent uses
DEMO_MAX_SECONDS=120             # the agent says goodbye and hangs up after this
DEMO_CALLS_PER_HOUR=3            # per visitor (IP address)
DEMO_MAX_CONCURRENT=3            # across all visitors

# --- Call recording (off until tested on real infrastructure) ---------------------
RECORDING_ENABLED=false
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=ap-south-1
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET_KEY=

# --- Compliance (confirm the window with telecom counsel) -----------------------
COMPLIANCE_CALLING_START_HOUR=9
COMPLIANCE_CALLING_END_HOUR=20
TIMEZONE=Asia/Kolkata
MAX_DIAL_ATTEMPTS_PER_LEAD=3
