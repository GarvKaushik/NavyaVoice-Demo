# ==============================================================================
# HINGLISH AI SALES CALLING AGENT - ENVIRONMENT CONFIGURATION
# Every setting and its default lives in config/settings.py
# ==============================================================================
ENVIRONMENT=development          # production refuses sandbox payments/messages and requires API_KEYS
API_KEYS=                        # comma-separated keys for the X-API-Key header (open in development if empty)
COMPANY_NAME=NavyaNexus
AGENT_PERSONA_NAME=Priya

# --- Real-time LLM (OpenAI-compatible; choose by benchmark) -------------------
REALTIME_LLM_API_KEY=your_sarvam_api_key_here
REALTIME_LLM_BASE_URL=https://api.sarvam.ai/v1
REALTIME_LLM_MODEL=sarvam-105b-conversations
REALTIME_LLM_EXTRA_BODY={"reasoning_effort": null}
REALTIME_LLM_TEMPERATURE=0.3
REALTIME_LLM_TIMEOUT_SECONDS=1.5
# Optional second vendor for failover
REALTIME_LLM_FALLBACK_BASE_URL=
REALTIME_LLM_FALLBACK_API_KEY=
REALTIME_LLM_FALLBACK_MODEL=

# --- Offline LLM (summaries, QA) ----------------------------------------------
OFFLINE_LLM_API_KEY=your_sarvam_api_key_here
OFFLINE_LLM_MODEL=sarvam-105b

# --- Sarvam speech -------------------------------------------------------------
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=translit         # Roman-script Hinglish transcripts
SARVAM_STT_SAMPLE_RATE=8000
BULBUL_TTS_MODEL=bulbul:v4-flash
BULBUL_TTS_VOICE_ID=simran_enhi_customer   # try ritu_hi_sales, simran_hi_sales, ishita_enhi_customer
BULBUL_TTS_SAMPLE_RATE=8000
BULBUL_TTS_PACE=1.0

# --- LiveKit (self-hosted, Mumbai) ---------------------------------------------
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=   # needed only for real phone calls

# --- Telephony (Plivo) ---------------------------------------------------------
PLIVO_AUTH_ID=your_plivo_auth_id_here
PLIVO_AUTH_TOKEN=your_plivo_auth_token_here
PLIVO_CALLER_ID_PROMOTIONAL=+911401234567
PLIVO_CALLER_ID_TRANSACTIONAL=
PLIVO_BILLING_PULSE_SECONDS=60
PLIVO_RATE_PER_MINUTE_INR=0.45
PLIVO_MAX_CALLS_PER_SECOND=2
PLIVO_ZENTRUNK_TERMINATION_URI=
PLIVO_ZENTRUNK_USERNAME=
PLIVO_ZENTRUNK_PASSWORD=
PLIVO_WHATSAPP_SENDER=
PLIVO_SMS_SENDER_ID=

# --- Payments & human transfer ---------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
HUMAN_TRANSFER_NUMBERS=          # e.g. +919800000001,+919800000002

# --- Data -----------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/voiceagent
REDIS_URL=redis://localhost:6379/0

# --- Compliance (confirm the window with telecom counsel) -----------------------
COMPLIANCE_CALLING_START_HOUR=9
COMPLIANCE_CALLING_END_HOUR=20
TIMEZONE=Asia/Kolkata
MAX_DIAL_ATTEMPTS_PER_LEAD=3
