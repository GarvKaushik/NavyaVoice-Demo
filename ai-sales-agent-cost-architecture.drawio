<mxfile host="app.diagrams.net"><diagram id="cost" name="Cost Architecture"><mxGraphModel dx="1300" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;AI Sales Calling Agent — Cost per Connected Minute&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="cust" value="&lt;b&gt;Customer's Phone&lt;/b&gt;&lt;br&gt;PSTN call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="160" height="100" as="geometry"/></mxCell><mxCell id="plivo" value="&lt;b&gt;Phone Line&lt;/b&gt;&lt;br&gt;Plivo SIP trunk&lt;br&gt;&lt;br&gt;&lt;b&gt;₹0.50 / min&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="130" width="160" height="100" as="geometry"/></mxCell><mxCell id="lk" value="&lt;b&gt;Call Router&lt;/b&gt;&lt;br&gt;LiveKit (self-hosted, India)&lt;br&gt;&lt;br&gt;&lt;b&gt;₹0.10 / min&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="130" width="160" height="100" as="geometry"/></mxCell><mxCell id="stt" value="&lt;b&gt;Ears&lt;/b&gt;&lt;br&gt;Sarvam Streaming STT&lt;br&gt;&lt;br&gt;&lt;b&gt;₹0.30 / min&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="130" width="160" height="100" as="geometry"/></mxCell><mxCell id="llm" value="&lt;b&gt;Brain&lt;/b&gt;&lt;br&gt;Sarvam 30B LLM&lt;br&gt;+ sales rules&lt;br&gt;&lt;b&gt;₹0.10 / min&lt;/b&gt;"